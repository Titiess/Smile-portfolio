# PostgreSQL connection string used by Prisma
DATABASE_URL=

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-time initial administrator setup; use a long random value and remove it after setup
ADMIN_SETUP_TOKEN=

# Supabase Storage. Keep the service-role key server-side; never add NEXT_PUBLIC_ to it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=portfolio-public
SUPABASE_PRIVATE_BUCKET=portfolio-private

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
